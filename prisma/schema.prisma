  city          String?
  zip           String?
  country       String?  @default("GR")
  // Misc
  isPrimary     Boolean  @default(false)                     // κύρια επαφή
  isActive      Boolean  @default(true)
  notes         String?
  order         Int      @default(0)
  avatarUrl         String?
  avatarStorageKey  String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([email])
  @@index([mobile])
}

model CompanyBranch {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String?                  // εσωτερικός κωδικός υποκαταστήματος
  s1Branch      Int?                     // SoftOne BRANCH κωδικός (όταν συγχρονίζεται)
  name          String                   // π.χ. "Έδρα", "Υποκατάστημα Θεσσαλονίκης"
  isHeadquarters Boolean @default(false)
  address       String?
  city          String?
  zip           String?
  country       String?  @default("GR")
  district      String?
  phone         String?
  phone2        String?
  fax           String?
  email         String?
  contactPerson String?
  notes         String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  latitude      Float?
  longitude     Float?
  geocodedAt    DateTime?
  regionCode    String?
  regionRef     Region?  @relation("BranchRegion", fields: [regionCode], references: [code])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([regionCode])
  @@unique([companyId, code])
