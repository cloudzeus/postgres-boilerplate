model CompanyTypeAssignment {
  companyId String
  typeId    String
  assignedAt DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      CompanyType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@id([companyId, typeId])
  @@index([typeId])
}

model ExcelImport {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  uploadedAt   DateTime @default(now())
  mappedFields Json?
  status       String   @default("PENDING")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// OCR / Intelligent Document Extraction (DeepSeek)
// ============================================================

enum OcrDocType {
  INVOICE
  RECEIPT
  GENERAL_TEXT
}

enum OcrPdfSource {
  DIGITAL
  SCANNED
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OcrCategory {
  EXPENSE
  INVOICE_IN
  INVOICE_OUT
  RECEIPT
  CREDIT_NOTE
  PAYROLL
  TAX
  OTHER
}

enum OcrPostStatus {
  NONE
  PENDING
  POSTED
  FAILED
}

model OcrDocument {
  id            String        @id @default(cuid())
  fileName      String                              // user-facing display name
  originalName  String
  storageKey    String        @unique                // Bunny path (private zone path)
  publicUrl     String                                // CDN URL or signed URL
  mimeType      String
  size          Int                                   // bytes
  docType       OcrDocType
  pdfSource     OcrPdfSource?                         // only for PDFs
  language      String        @default("el")          // ISO code: el / en / de ...
  status        OcrStatus     @default(PENDING)
  rawText       String?       @db.Text                // pdf-parse output (DIGITAL path)
  extractedData Json?                                 // full structured payload returned by LLM (παράγωγο του `document`)
  // Κανονικό JSON εγγράφου (spec §17.1): kind/type/issuer/recipient/lines/totals/vatBreakdown/
  // digital/payment/references/notes/handwritten/custom. Πηγή αλήθειας για Excel και SoftOne posting.
  document      Json?
  errorMessage  String?       @db.Text
  model         String?                               // which DeepSeek model was used
  tokensUsed    Int?
  durationMs    Int?
  createdById   String?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?
  // Thumbnail (small WebP preview) cached on Bunny CDN.
  thumbKey      String?
  thumbUrl      String?
  // Categorization + downstream posting state.
  category      OcrCategory?
  notes         String?       @db.Text
  postStatus    OcrPostStatus @default(NONE)
  postedAt      DateTime?
  postedRef     String?                                 // SoftOne FINDOC ref / external doc id
  postError     String?       @db.Text
  // ΑΦΜ εκδότη, κανονικοποιημένο (μόνο ψηφία) από το `extractedData.vatNumber`, γραμμένο
  // τη στιγμή της εξαγωγής. Υπάρχει ώστε οι ουρές να ρωτούν με index αντί για σάρωση JSON.
  issuerAfm      String?
  // Επιβεβαίωση ΑΠΟ ΑΝΘΡΩΠΟ: γράφεται όταν κάποιος διορθώσει/αποθηκεύσει την ανάγνωση ή όταν το
  // έγγραφο καταχωριστεί στο SoftOne. Μόνο τέτοια έγγραφα γίνονται παράδειγμα αναφοράς για τον
  // ίδιο εκδότη (`lib/ocr/example-lookup.ts`) — ποτέ αυτόματο αποτέλεσμα.
  verifiedAt     DateTime?
  verifiedById   String?
  // SoftOne supplier match (issuer ΑΦΜ → TRDR SODTYPE=12), filled on extraction.
  softoneTrdr    Int?                                    // matched supplier TRDR id
  softoneCode    String?                                 // matched supplier CODE
  softoneName    String?                                 // matched supplier NAME
  softoneKind    String?                                 // Προμηθευτής / Πιστωτής (SODTYPE)
  softoneChecked DateTime?                               // when the SoftOne lookup ran (null = not yet)
  invoiceKind    String?                                 // DeepSeek: service | product | mixed
  // PURDOC duplicate check (supplier + αριθμός + ημ/νία already in SoftOne).
  softoneDocExists  Boolean?                              // true = πιθανό διπλό βρέθηκε
  softoneDocRef     String?                               // FINCODE του υπάρχοντος παραστατικού
  softoneDocChecked DateTime?
  // Reconciliation / εκκρεμότητα. The display status is *derived* (see lib/ocr/recon-status.ts);
  // reconOverride is the manual hybrid lock: null = auto, RESOLVED = ολοκληρώθηκε, IGNORED = αγνοήθηκε.
  reconOverride String?                                   // null | RESOLVED | IGNORED
  itemsTotal    Int?                                      // # invoice lines (persisted at correlation)
  itemsMatched  Int?                                      // # lines matched to SoftOne MTRL
  // Chosen SoftOne document SERIES (PurchaseDocType.code) for posting. Replaces the
  // old free-text "Τύπος παραστατικού" with the real SoftOne series.
  softoneSeries String?
  // Αναγνώριση τύπου κατά τη σάρωση (spec 2026-09-11 §1).
  seriesSource     Int?                                   // SOSOURCE της επιλεγμένης σειράς (1251 αγορών / 1653 πιστωτών)
  seriesConfidence Float?                                 // 0–1
  seriesReason     String?                                // γιατί επιλέχθηκε (tooltip)
  seriesBy         String?                                // auto | manual
  // Folder/batch this document belongs to (folder upload).
  batchId       String?
  batch         OcrBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  items         OcrInvoiceItem[]
  // Company & tax-template linkage
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  taxTemplateId String?
  taxTemplate   TaxFormTemplate? @relation(fields: [taxTemplateId], references: [id], onDelete: SetNull)
  templateRuns  TemplateRun[]
  reviewFlags   Json?                                 // { review: string[], blocked: string[], templateSlug, templateName, runStatus, runId } — latest run, for the list
  fiscalYear    Int?

  @@index([status])
  @@index([docType])
  @@index([category])
  @@index([postStatus])
  @@index([createdAt])
  @@index([batchId])
  @@index([companyId])
  @@index([issuerAfm])
  @@index([issuerAfm, verifiedAt])
}

// A folder/batch of uploaded documents processed together.
model OcrBatch {
  id          String        @id @default(cuid())
  name        String                                    // folder name
  docType     OcrDocType    @default(INVOICE)
  language    String        @default("el")
  createdById String?
  createdAt   DateTime      @default(now())
  documents   OcrDocument[]
  // Πολυ-παραστατικό PDF: το ΠΡΩΤΟΤΥΠΟ αρχείο που κόπηκε σε αυτόν τον φάκελο. Null για φακέλους
  // που φτιάχτηκαν από ανέβασμα φακέλου (εκεί κάθε αρχείο είναι ήδη ξεχωριστό έγγραφο).
  sourceKey   String?                                   // Bunny path: ocr/batches/{id}/source.pdf
  sourceName  String?                                   // το όνομα που ανέβασε ο χρήστης
  sourcePages Int?                                      // σελίδες του πρωτοτύπου

  @@index([createdAt])
}

// ============================================================
// European funding programs (ΕΣΠΑ / EU calls) — separate OCR pipeline
// ============================================================

enum ProgramStatus {
  DRAFT       // newly extracted, not reviewed
  REVIEWING   // user is editing
  PUBLISHED   // finalized, visible to internal users
  ARCHIVED
}

enum ProgramExtractStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/**
 * Κανόνας επιλεξιμότητας ΚΑΔ — το PDF συχνά αναφέρει είτε λίστα επιλέξιμων
 * (allow-list) είτε λίστα εξαιρούμενων (deny-list), σπάνια και τα δύο.
 */
enum KadEligibilityRule {
  ALL_EXCEPT_LISTED   // Όλοι οι ΚΑΔ είναι επιλέξιμοι ΕΚΤΟΣ από αυτούς που έχει flag excluded=true
  ONLY_LISTED         // Επιλέξιμοι ΜΟΝΟ οι ρητά αναφερόμενοι (excluded=false)
  MIXED               // Συνδυασμός — υπάρχει λίστα επιλέξιμων αλλά και εξαιρέσεις
  UNSPECIFIED         // Το PDF δεν διευκρινίζει
}

model Program {
  id              String        @id @default(cuid())
  // Core fields
  title           String                                 // required, editable
  summary         String?       @db.Text
  // Source PDF (Bunny private)
  sourceFileName  String?
  storageKey      String?       @unique
  publicUrl       String?
  mimeType        String?
  size            Int?
  // Dates
  publicationDate DateTime?
  submissionStart DateTime?
  submissionEnd   DateTime?
  // Budget & funding
  totalBudget     Decimal?      @db.Decimal(18, 2)       // total project budget €
  fundingRate     Decimal?      @db.Decimal(5, 2)        // subsidy percentage (e.g. 50.00)
  durationMonths  Int?
  // Reference codes (e.g. ΕΣΠΑ 2021-2027 codes)
  referenceCode   String?
  // ΚΑΔ eligibility rule (how to interpret the kads[] list)
  kadRule         KadEligibilityRule @default(UNSPECIFIED)
  kadRuleNote     String?            @db.Text       // free-form explanation from PDF
  // Eligibility thresholds for the applicant company
  minEmployeesFte     Decimal?       @db.Decimal(10, 2)   // ελάχιστες ΕΜΕ (Ετήσιες Μονάδες Εργασίας)
  minOperationalYears Decimal?       @db.Decimal(5, 2)    // ελάχιστα έτη λειτουργίας / διαχειριστικές χρήσεις
  eligibilityNote     String?        @db.Text             // free-form summary of eligibility
  // Status (lifecycle for the user, not LLM)
  status          ProgramStatus @default(DRAFT)
  // Extraction metadata
  extractStatus   ProgramExtractStatus @default(PENDING)
  extractedData   Json?
  errorMessage    String?       @db.Text
  model           String?
  tokensUsed      Int?
  durationMs      Int?
  // Manual notes
  notes           String?       @db.Text
  // Audit
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // Relations
  kads            ProgramKad[]
  expenseCats     ProgramExpenseCategory[]
  regions         ProgramRegion[]
  criteria        ProgramCriterion[]
  deadlines       ProgramDeadline[]
  phases          ProgramPhase[]
  legalForms      ProgramEligibleLegalForm[]
  bonuses         ProgramBonus[]
  files           ProgramFile[]
  questionnaire   ProgramQuestionnaire?
  assessments     CompanyAssessment[]
  requiredFields  ProgramRequiredField[]

  @@index([status])
  @@index([extractStatus])
  @@index([submissionEnd])
  @@index([createdAt])
}

model ProgramKad {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  code            String                                 // canonical dotted, e.g. "62.01.11"
  codeWithoutDots String?
  description     String?  @db.Text
  excluded        Boolean  @default(false)               // true ⇒ ΚΑΔ που ρητά εξαιρείται

  @@unique([programId, code])
  @@index([programId])
  @@index([code])
  @@index([excluded])
}

model ProgramExpenseCategory {
  id            String   @id @default(cuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name          String                                  // "Μισθολογικό κόστος", "Εξοπλισμός", etc.
  minAmount     Decimal? @db.Decimal(18, 2)             // absolute floor in €
  minPercentage Decimal? @db.Decimal(5, 2)              // floor as % of total budget
  maxAmount     Decimal? @db.Decimal(18, 2)             // absolute cap in €
  maxPercentage Decimal? @db.Decimal(5, 2)              // cap as % of total budget
  mandatory     Boolean  @default(false)                // υποχρεωτική κατηγορία δαπάνης
  notes         String?  @db.Text
  order         Int      @default(0)

  @@index([programId])
  @@index([mandatory])
}

enum ProgramBonusKind {
  TIME_BASED       // π.χ. +10% αν ολοκλήρωση σε ≤9 μήνες
  EMPLOYMENT       // π.χ. +5% για κάθε νέα θέση εργασίας
  SUSTAINABILITY   // π.χ. +5% για πράσινες δαπάνες
  WOMEN_LED        // π.χ. +5% για γυναικείες επιχειρήσεις
  YOUTH            // π.χ. +5% για επιχειρηματίες <30 ετών
  R_AND_D          // +X% για ερευνητικές δαπάνες
  OTHER
}

model ProgramBonus {
  id              String           @id @default(cuid())
  programId       String
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  kind            ProgramBonusKind @default(OTHER)
  name            String                                          // "Bonus γρήγορης ολοκλήρωσης"
  condition       String           @db.Text                       // "Ολοκλήρωση φυσικού αντικειμένου εντός 9 μηνών"
  bonusRate       Decimal?         @db.Decimal(5, 2)              // π.χ. 10.00 (= +10%)
  bonusAmount     Decimal?         @db.Decimal(18, 2)             // απόλυτο ποσό αν δίνεται
  order           Int              @default(0)

  @@index([programId])
}

enum ProgramFileKind {
  MAIN              // κύριος οδηγός / πρόσκληση
  ANNEX             // παράρτημα
  CLARIFICATION     // διευκρινίσεις / επικαιροποίηση
  AMENDMENT         // τροποποίηση
  OTHER
}

model ProgramFile {
  id          String          @id @default(cuid())
  programId   String
  program     Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  fileName    String
  storageKey  String          @unique
  publicUrl   String?
  mimeType    String
  size        Int
  kind        ProgramFileKind @default(OTHER)
  label       String?                                              // user-facing label
  uploadedAt  DateTime        @default(now())
  uploadedById String?

  @@index([programId])
  @@index([kind])
}

model ProgramEligibleLegalForm {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String                                       // "ΙΚΕ", "ΕΠΕ", "ΑΕ", "Ατομική", "ΟΕ", "ΕΕ" κλπ.
  notes     String?

  @@unique([programId, name])
  @@index([programId])
}

model ProgramRegion {
  id           String   @id @default(cuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String                                   // "Αττική", "Δυτική Ελλάδα", ...
  fundingRate  Decimal? @db.Decimal(5, 2)               // regional override of subsidy % (some programs vary)
  notes        String?

  @@index([programId])
}

model ProgramCriterion {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  order     Int      @default(0)

  @@index([programId])
}

model ProgramDeadline {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  deadline    DateTime
  description String?
  order       Int      @default(0)

  @@index([programId])
}

// ============================================================
// Supporting documents — catalog, program phases, requirements
// ============================================================

/// Global catalog of supporting-document types (δικαιολογητικά), reused across all programs.
model DocumentType {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  category       String?
  requiresExpiry Boolean  @default(true)
  notifyExpiry   Boolean  @default(true)
  active         Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  categoryId     String?
  categoryRef    DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  requirements PhaseDocumentRequirement[]

  @@index([active])
  @@index([categoryId])
}

/// Free-form phases of a program (e.g. Υποβολή → Ένταξη → Υλοποίηση → Ολοκλήρωση). No dates here.
model ProgramPhase {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name            String
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  phaseTemplateId String?
  phaseTemplate   PhaseTemplate? @relation(fields: [phaseTemplateId], references: [id], onDelete: SetNull)

  requirements PhaseDocumentRequirement[]

  @@index([programId])
}

/// Which document types are required at which phase, and whether mandatory.
model PhaseDocumentRequirement {
  id             String       @id @default(cuid())
  phaseId        String
  phase          ProgramPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  mandatory      Boolean      @default(true)
  notes          String?
  appliesToAll   Boolean      @default(false)
  businessTypes  RequirementBusinessType[]

  @@unique([phaseId, documentTypeId])
  @@index([phaseId])
  @@index([documentTypeId])
}

model BusinessType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies    Company[]
  requirements RequirementBusinessType[]

  @@index([active])
  @@index([order])
}

model DocumentCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentTypes DocumentType[]

  @@index([active])
}

model PhaseTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phases ProgramPhase[]

  @@index([active])
  @@index([order])
}

model RequirementBusinessType {
  id             String   @id @default(cuid())
  requirementId  String
  requirement    PhaseDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  businessTypeId String
  businessType   BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@unique([requirementId, businessTypeId])
  @@index([requirementId])
  @@index([businessTypeId])
}

// ============================================================
// AI usage & cost tracking (SUPER_ADMIN only)
// ============================================================

enum AiScope {
  OCR_TEXT          // DeepSeek text model on digital PDF
  OCR_VISION        // Gemini / VLM vision call (image or scanned PDF page)
  OCR_VISION_RETRY  // upgraded-model retry firing on missing-fields
  TRANSLATION       // DeepSeek translation
  TAX_FORM          // Tax-form field extraction via vision pipeline
  OTHER
}

model AiUsage {
  id           String   @id @default(cuid())
  scope        AiScope
  provider     String                              // "deepseek" | "gemini" | "openai" | ...
  model        String                              // "deepseek-chat" | "gemini-2.5-flash" | ...
  operation    String?                             // free-form (e.g. "ocr.invoice", "i18n.batch")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  inputCost    Decimal? @db.Decimal(12, 6)         // USD
  outputCost   Decimal? @db.Decimal(12, 6)         // USD
  totalCost    Decimal? @db.Decimal(12, 6)         // USD
  durationMs   Int?
  userId       String?
  refType      String?                             // "OcrDocument" etc.
  refId        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([scope])
  @@index([model])
  @@index([userId])
}

model OcrInvoiceItem {
  id          String      @id @default(cuid())
  documentId  String
  document    OcrDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rowIndex    Int
  code        String?
  name        String
  quantity    Decimal?    @db.Decimal(18, 4)
  price       Decimal?    @db.Decimal(18, 4)
  discount    Decimal?    @db.Decimal(18, 4)
  vatRate     Decimal?    @db.Decimal(5, 2)
  total       Decimal?    @db.Decimal(18, 4)
  // SoftOne item match (filled by correlation; null = δεν βρέθηκε).
  softoneMtrl      Int?
  softoneCode      String?
  softoneName      String?
  softoneIsService Boolean?
  softoneMatchedBy String?                              // code2 | code1 | code | manual | memory | skipped
  // Αντιστοίχιση σε έξοδο SoftOne (EXPENSES/EXPN) αντί για είδος.
  softoneExpn      Int?
  // Αντιστοίχιση σε ΧΡΕΟΠΙΣΤΩΣΗ SoftOne (LINEITEM → MTRL με SODTYPE 53). Ξεχωριστή στήλη από το
  // `softoneMtrl`: και οι δύο κρατούν MTRL, αλλά μόνο η χρεοπίστωση μπαίνει σε γραμμή LINLINES.
  softoneLinMtrl   Int?
  // Αναλυτική ανά γραμμή: κέντρο κόστους, έργο, κατηγορία δραστηριότητας. Και τα τρία είναι
  // ΠΡΟΑΙΡΕΤΙΚΑ στο SoftOne — δεν μπλοκάρουν ποτέ καταχώριση.
  softoneCostCntr  Int?
  softonePrjc      Int?
  softonePrjcStage Int?

  @@index([documentId])
  @@index([softoneMtrl])
  @@index([softoneExpn])
  @@index([softoneLinMtrl])
}

// ============================================================
// Tax-form templates, per-company financial values, program required fields
// ============================================================

model TaxFormTemplate {
  id               String   @id @default(cuid())
  code             String
  name             String
  year             Int?
  description      String?  @db.Text
  status           TaxTemplateStatus @default(DRAFT)
  sampleStorageKey String?
  samplePageCount  Int?
  sampleThumbUrl   String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  fields           TaxFormTemplateField[]
  requiredBy       ProgramRequiredField[]
  documents        OcrDocument[]

  @@unique([code, year])
  @@index([status])
}

model TaxFormTemplateField {
  id          String   @id @default(cuid())
  templateId  String
  template    TaxFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey    String
  label       String
  section     String?
  valueType   FinancialValueType @default(CURRENCY)
  kind        TaxFieldKind @default(SINGLE)
  config      Json?        // for TABLE (records): { columns: string[] }
  regionHint  Json?
  aiHint      String?  @db.Text
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([templateId, fieldKey])
  @@index([templateId])
}

model CompanyFinancialValue {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fieldKey         String
  templateId       String?
  year             Int
  value            Decimal? @db.Decimal(18, 2)   // numeric value (SINGLE/SERIES point)
  valueText        String?  @db.Text             // for DATE / free text values
  valueJson        Json?                          // for TABLE (records): array of objects
  kind             TaxFieldKind @default(SINGLE)
  valueType        FinancialValueType
  source           FinancialValueSource @default(OCR)
  sourceDocumentId String?
  confidence       Float?
  verified         Boolean  @default(false)
  verifiedById     String?
  periodStart      DateTime?
  periodEnd        DateTime?
  validUntil       DateTime?
  note             String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, fieldKey, year])
  @@index([companyId])
  @@index([fieldKey, year])
}

model ProgramRequiredField {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  templateId  String
  template    TaxFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey    String
  yearsBack   Int      @default(1)
  mandatory   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([programId, templateId, fieldKey])
  @@index([programId])
}

// ============================================================
// Self-assessment questionnaire (per Program) & company evaluation
// ============================================================

enum QuestionnaireScoringModel {
  WEIGHTED
  POINTS_SUM
}

enum QuestionnaireStatus {
  DRAFT
  READY
}

enum QuestionAnswerType {
  BOOLEAN
  SINGLE_CHOICE
  NUMERIC
  SCALE
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
}

enum AssessmentVerdict {
  ELIGIBLE
  NOT_ELIGIBLE
  NEEDS_REVIEW
}

enum AnswerSource {
  AUTO
  MANUAL
}

model ProgramQuestionnaire {
  id             String   @id @default(cuid())
  programId      String   @unique
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  title          String?
  description    String?  @db.Text
  scoringModel   QuestionnaireScoringModel @default(WEIGHTED)
  threshold      Decimal? @db.Decimal(8, 2)
  maxScore       Decimal? @db.Decimal(8, 2)
  sourceNote     String?
  status         QuestionnaireStatus @default(DRAFT)
  generatedModel String?
  generatedAt    DateTime?
  computedCriteria Json?   // ① computed criteria (variables↔E3 mappings, formula, bands, weight)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  questions      ProgramQuestion[]
  assessments    CompanyAssessment[]
}

model ProgramQuestion {
  id              String   @id @default(cuid())
  questionnaireId String
  questionnaire   ProgramQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  code            String?
  text            String   @db.Text
  criterionRef    String?
  helpText        String?  @db.Text
  answerType      QuestionAnswerType @default(SINGLE_CHOICE)
  weight          Decimal? @db.Decimal(8, 2)
  maxPoints       Decimal? @db.Decimal(8, 2)
  companyField    String?
  order           Int      @default(0)
  options         ProgramQuestionOption[]
  answers         AssessmentAnswer[]
  @@index([questionnaireId])
}

model ProgramQuestionOption {
  id          String  @id @default(cuid())
  questionId  String
  question    ProgramQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String
  points      Decimal @default(0) @db.Decimal(8, 2)
  order       Int     @default(0)
  @@index([questionId])
}

model CompanyAssessment {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  programId           String
  program             Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  questionnaireId     String?
  questionnaire       ProgramQuestionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  eligible            Boolean?
  eligibilityResult   Json?
  questionnaireScore  Decimal? @db.Decimal(8, 2)
  questionnaireMax    Decimal? @db.Decimal(8, 2)
  questionnairePassed Boolean?
  overallVerdict      AssessmentVerdict @default(NEEDS_REVIEW)
  status              AssessmentStatus  @default(DRAFT)
  notes               String?  @db.Text
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  answers             AssessmentAnswer[]
  @@index([companyId])
  @@index([programId])
  @@index([programId, eligible])
}

model AssessmentAnswer {
  id               String  @id @default(cuid())
  assessmentId     String
  assessment       CompanyAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId       String
  question         ProgramQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  valueBool        Boolean?
  valueNumber      Decimal? @db.Decimal(14, 4)
  valueText        String?  @db.Text
  selectedOptionId String?  // intentional loose ref (no FK): questionnaire regen full-replaces options; we keep historical answers
  pointsAwarded    Decimal? @db.Decimal(8, 2)
  source           AnswerSource @default(MANUAL)
  @@index([assessmentId])
  @@index([questionId])
}

// ─── Πρότυπα εξαγωγής προμηθευτή (extraction templates) ─────────────────────
// Spec: docs/superpowers/specs/2026-09-09-extraction-templates-design.md

enum TemplateMode {
  AUTO
  SEMI_AUTO
  MANUAL
}

enum TemplateStatus {
  DRAFT
  ACTIVE
}

enum TemplateFieldKind {
  SINGLE
  TABLE
}

enum TemplateValueType {
  TEXT
  NUMBER
  CURRENCY
  DATE
  LIST
}

enum MappingTarget {
  INVOICE
  EXCEL
}

enum TemplateRunStatus {
  EXTRACTED
  REVIEW
  BLOCKED
  POSTED
  FAILED
}

enum TemplateSampleStatus {
  PENDING
  READ
  VERIFIED
}

enum TemplateJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum TemplateJobItemStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model ExtractionTemplate {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique         // auto από name — κλειδί του JSON εξόδου
  department       String?                         // τμήμα / κατηγορία (ελεύθερο κείμενο)
  vatNumber        String?                         // ΑΦΜ προμηθευτή — προαιρετική συσχέτιση
  traderTrdr       Int?                            // → SoftoneTrader.trdr (προαιρετικό)
  supplierName     String?                         // denormalized για λίστες
  mode             TemplateMode    @default(MANUAL)
  status           TemplateStatus  @default(DRAFT)
  version          Int             @default(1)
  sampleStorageKey String?                         // Bunny private — δείγμα εικόνας/PDF
  sampleMimeType   String?
  samplePageCount  Int?
  sampleThumbUrl   String?
  // Αποτύπωμα διάταξης του κύριου δείγματος (§14.7) — { afm, issuer, words[], aspect }.
  fingerprint      Json?
  // Κατώφλια ενεργοποίησης (§11): 0 δείγματα = χωρίς έλεγχο εκπαίδευσης.
  minTrainingScore   Float         @default(0.9)
  minTrainingSamples Int           @default(3)
  trainingScore      Float?                        // τελευταίος υπολογισμένος συνολικός βαθμός 0-1
  verifiedSamples    Int           @default(0)     // πλήθος δειγμάτων σε status VERIFIED
  notifyEmails     String?                         // ";"-separated (NOTIFY)
  timesUsed        Int             @default(0)
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  fields           TemplateField[]
  mappings         TemplateMapping[]
  conditions       TemplateCondition[]
  runs             TemplateRun[]
  samples          TemplateSample[]
  jobs             TemplateJob[]

  @@index([vatNumber, status])
}

model TemplateField {
  id         String             @id @default(cuid())
  templateId String
  template   ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String                                // slug (auto από label), σταθερό
  label      String
  kind       TemplateFieldKind  @default(SINGLE)
  valueType  TemplateValueType  @default(TEXT)
  color      String                                // hex, μοναδικό μέσα στο πρότυπο
  region     Json?                                 // { page:number, bbox:[x,y,w,h] } 0-1
  columns    Json?                                 // TABLE → [{ key, label, valueType }]
  aiHint     String?            @db.Text
  required   Boolean            @default(false)
  order      Int                @default(0)
  // §17.2 — τελευταία επιτυχημένη θέση: { page, bbox:[x,y,w,h], at, n } (κινητός μέσος όρος, n ≤ 10).
  lastGood   Json?

  @@unique([templateId, key])
  @@index([templateId])
}

model TemplateMapping {
  id         String             @id @default(cuid())
  templateId String
  template   ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String             @default("default")
  target     MappingTarget
  isDefault  Boolean            @default(true)
  rows       Json                                  // INVOICE: [{fieldKey, invoiceKey}] · EXCEL: [{fieldKey, column, order}]

  @@unique([templateId, name])
}

model TemplateCondition {
  id         String             @id @default(cuid())
  templateId String
  template   ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  order      Int                @default(0)
  isActive   Boolean            @default(true)
  logic      String             @default("AND")   // AND | OR
  clauses    Json                                  // [{ fieldKey, op, value }]
  actions    Json                                  // [{ type, params }]

  @@index([templateId, order])
}

model TemplateRun {
  id              String             @id @default(cuid())
  templateId      String
  template        ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion Int
  documentId      String
  document        OcrDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status          TemplateRunStatus
  trigger         String             @default("upload")   // upload | manual | reextract
  error           String?            @db.Text
  values          Json                              // { key: FieldValue }
  // Φάκελος εξόδου v3: { template, version, extractedAt, file, documentId, document } (spec §17.1).
  output          Json?
  matched         Json                              // [{ id, name, actions }]
  // { review: string[], blocked: string[], fields: Record<string, 'review'|'blocked'>, notified: string[],
  //   baseOcr: Record<string, unknown> }
  // baseOcr = what the base OCR read for the cross-checked keys (totalAmount, subtotal, vatAmount,
  // invoiceNumber, date) BEFORE this run projected over document.extractedData. Every later re-check of
  // «Ασυμφωνία …» (a manual correction, a per-field re-read) compares against it — comparing with the
  // live extractedData would compare the template with its own projection. Runs written before this
  // existed have no baseOcr and keep the mismatch reasons they already carry.
  flags           Json?
  mappingName     String
  model           String?
  tokensUsed      Int?
  durationMs      Int?
  createdAt       DateTime           @default(now())

  @@index([documentId])
  @@index([documentId, createdAt])
  @@index([templateId, createdAt])
}

// Δείγματα εκπαίδευσης (spec §11) — πολλά αρχεία ανά πρότυπο, με επιβεβαιωμένες τιμές.
model TemplateSample {
  id          String               @id @default(cuid())
  templateId  String
  template    ExtractionTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fileName    String
  storageKey  String
  mimeType    String
  pageCount   Int?
  status      TemplateSampleStatus @default(PENDING)
  expected    Json?                                 // { fieldKey: value } επιβεβαιωμένο από χρήστη
  lastResult  Json?                                 // { fieldKey: { raw, value, source, match } }
  score       Float?                                // 0-1 ποσοστό πεδίων που ταιριάζουν
  fingerprint Json?                                 // §14.7 — { afm, issuer, words[], aspect }
  isPrimary   Boolean              @default(false)  // το δείγμα πάνω στο οποίο σχεδιάστηκαν οι περιοχές
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([templateId])
}

// Εργασίες μαζικής σάρωσης (spec §12).
model TemplateJob {
  id              String            @id @default(cuid())
  templateId      String
  template        ExtractionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersion Int
  status          TemplateJobStatus @default(QUEUED)
  title           String?                                // τίτλος της παρτίδας, όπως τον έγραψε ο χρήστης
  reference       String?                                // ελεύθερη σήμανση/κωδικός του χρήστη
  docDate         DateTime?                              // ημερομηνία αναφοράς που δίνει ο χρήστης (≠ createdAt)
  description     String?
  notifyEmails    String?                                // comma-separated· κενό → τα emails του προτύπου
  total           Int               @default(0)
  done            Int               @default(0)
  failed          Int               @default(0)
  createdById     String?
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  items           TemplateJobItem[]

  @@index([status, createdAt])
  @@index([templateId, createdAt])
}

model TemplateJobItem {
  id         String                @id @default(cuid())
  jobId      String
  job        TemplateJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order      Int
  fileName   String
  storageKey String
  mimeType   String
  size       Int
  status     TemplateJobItemStatus @default(QUEUED)
  page       Int?                                   // πλήθος σελίδων του αρχείου (για το page-image)
  values     Json?                                  // { fieldKey: FieldValue }
  matched    Json?
  flags      Json?
  model      String?
  tokensUsed Int?
  durationMs Int?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([jobId, order])
  @@index([status])
}

// Έξοδα SoftOne (EditMaster EXPENSES, πίνακας EXPN) — μητρώο για την αντιστοίχιση γραμμών.
model SoftoneExpense {
  id       Int      @id @default(autoincrement())
  expn     Int      @unique           // SoftOne EXPN id
  code     String                     // CODE
  name     String                     // NAME
  vat      String?                    // VAT (κατηγορία ΦΠΑ)
  isActive Boolean  @default(true)
  syncedAt DateTime @default(now())
  // Χαρακτηρισμός myDATA του ΜΗΤΡΩΟΥ (όχι της γραμμής). Το EXPN κρατά δύο ζεύγη: εσόδων και
  // εξόδων (…X). Για παραστατικά που λαμβάνουμε ισχύει το ζεύγος ΕΞΟΔΩΝ.
  classType       Int?                // CLASSTYPE       (εσόδων)
  classTypeX      Int?                // CLASSTYPEX      (εξόδων)
  classCategory   Int?                // CLASSCATEGORY   (εσόδων)
  classCategoryX  Int?                // CLASSCATEGORYEX (εξόδων)
  myDataVprc      Int?                // MYDATAVPRC (κατηγορία φόρων)

  @@index([name])
  @@index([code])
}

// Χρεοπιστώσεις SoftOne — object LINEITEM (EditMaster «Χρεοπιστώσεις») → πίνακας MTRL με
// SODTYPE 53 (51 είδη · 52 υπηρεσίες · 53 χρεοπιστώσεις · 54 πάγια). Είναι ΑΥΤΕΣ που δέχεται το
// `MTRL` μιας γραμμής LINLINES («Ειδικές συναλλαγές»), όχι τα είδη/υπηρεσίες ούτε τα έξοδα.
model SoftoneLineItem {
  id       Int      @id @default(autoincrement())
  mtrl     Int      @unique           // SoftOne MTRL id (SODTYPE 53)
  code     String                     // CODE
  name     String                     // NAME
  vat      String?                    // VAT (κατηγορία ΦΠΑ)
  mtrType  Int?                       // MTRTYPE («Τύπος», editor $LINTYPE) — το θέλει η γραμμή LINLINES
  mtrCategory Int?                    // MTRCATEGORY → SoftoneLineCategory.mtrCategory (κατηγορία δαπάνης)
  isActive Boolean  @default(true)
  syncedAt DateTime @default(now())
  // Χαρακτηρισμός myDATA του ΜΗΤΡΩΟΥ — η γραμμή LINLINES δεν έχει πεδίο χαρακτηρισμού.
  classType     Int?                  // CLASSTYPE
  classCategory Int?                  // CLASSCATEGORY
  myDataCode    String?               // MYDATACODE («Στοιχεία εσόδων / εξόδων»)
  myDataVprc    Int?                  // MYDATAVPRC
  // Λογαριασμός γενικής λογιστικής της χρεοπίστωσης — `MTRL.ACNMSK` («Γενικής», editor ACNTGL).
  // ΠΡΟΣΟΧΗ, δύο διαφορετικά «κενά»: `acnmskSyncedAt = null` σημαίνει ότι ο συγχρονισμός δεν έχει
  // διαβάσει ΑΚΟΜΗ το πεδίο (άγνωστο), ενώ `acnmsk = null` με `acnmskSyncedAt` γεμάτο σημαίνει ότι
  // το SoftOne το έχει ΚΕΝΟ. Το «δεν ξέρω» δεν επιτρέπεται να διαβαστεί ως «λείπει».
  // Μπορεί να είναι ΜΑΣΚΑ με `*` (π.χ. «32.*»), όχι μόνο πλήρης κωδικός — βλ. `lib/ocr/account-check.ts`.
  acnmsk         String?
  acnmskSyncedAt DateTime?

  @@index([name])
  @@index([code])
  @@index([mtrCategory])
}

// Λογιστικό σχέδιο SoftOne — πίνακας ACNT (Γενική λογιστική). Καθρέφτης ΜΟΝΟ ΓΙΑ ΑΝΑΓΝΩΣΗ: με αυτόν
// ο έλεγχος πριν την καταχώριση λέει ΣΕ ΠΟΙΟΝ λογαριασμό θα πάει κάθε γραμμή και αν αυτός υπάρχει.
// Ο πελάτης έχει ΕΓΛΣ: 4 βαθμίδες, με την 4η να είναι κατάληξη συντελεστή ΦΠΑ (…0024, …0013).
model SoftoneAccount {
  id         Int      @id @default(autoincrement())
  acnt       Int      @unique            // ACNT (κλειδί)
  code       String   @unique            // CODE, π.χ. «61.02.00.0024»
  name       String                      // NAME
  grade      Int?                        // ACNGRADE — βαθμίδα 1..4
  // Ο κωδικός χωρίς το τελευταίο τμήμα («61.02.00.0024» → «61.02.00»). Υπολογίζεται εδώ, δεν
  // έρχεται από το SoftOne· κενό για πρωτοβάθμιους.
  parentCode String?
  sodtype    Int?                        // SODTYPE (89 γενική · 90 ομάδα 9 αναλυτικής)
  // ACNMOVING «Κινείται»: ο λογαριασμός δέχεται εγγραφές. `null` = δεν διαβάστηκε — ΑΓΝΩΣΤΟ, ποτέ
  // «κινείται». (Στον πελάτη ΔΕΝ υπάρχουν GLMASTER / ISFINAL — το σχέδιο είναι ACNT, η σημαία ACNMOVING.)
  postable   Boolean?
  isActive   Boolean  @default(true)
  syncedAt   DateTime @default(now())

  @@index([parentCode])
}

// Κατηγορίες δαπανών SoftOne — object LINCATEGORY (EditMaster «Κατηγορίες δαπανών») → πίνακας
// MTRCATEGORY με SODTYPE 53. Είναι η ομαδοποίηση ΠΑΝΩ από τις χρεοπιστώσεις (`LINEITEM.MTRCATEGORY`),
// όχι ξεχωριστή λίστα δαπανών· τη χρησιμοποιεί η ουρά για να στενέψει την αναζήτηση χρεοπίστωσης.
model SoftoneLineCategory {
  id          Int      @id @default(autoincrement())
  mtrCategory Int      @unique          // SoftOne MTRCATEGORY id (SODTYPE 53)
  code        String                    // CODE (σύντμηση)
  name        String                    // NAME (περιγραφή)
  vat         String?                   // VAT (προεπιλεγμένη κατηγορία ΦΠΑ της κατηγορίας)
  acnmsk      String?                   // ACNMSK (λογαριασμός γενικής)
  // `false` = η εγκατάσταση δεν εξέθεσε SODTYPE στον MTRCATEGORY, οπότε ο κατάλογος μπορεί να
  // περιέχει και κατηγορίες ειδών/υπηρεσιών/παγίων. Το UI το λέει αντί να το κρύβει.
  sodtypeFiltered Boolean @default(true)
  isActive    Boolean  @default(true)
  syncedAt    DateTime @default(now())

  @@index([name])
  @@index([code])
}

// Κέντρα κόστους SoftOne — object PRSCOSTCNTR («Κέντρα κόστους») → DB πίνακας COSTCNTR.
// Μπαίνουν ΑΝΑ ΓΡΑΜΜΗ (`COSTCNTR`) σε ITELINES / SRVLINES / LINLINES· το EXPANAL ΔΕΝ το έχει.
model SoftoneCostCenter {
  id       Int      @id @default(autoincrement())
  costcntr Int      @unique          // SoftOne COSTCNTR (Integer key)
  code     String                    // CODE (σύντμηση)
  name     String                    // NAME (περιγραφή)
  name2    String?                   // NAME2
  sohCode  String?                   // SOHCODE (κωδικός ιεραρχίας)
  acnmsk   String?                   // ACNMSK (λογαριασμός)
  isActive Boolean  @default(true)
  syncedAt DateTime @default(now())

  @@index([name])
  @@index([code])
}

// Έργα SoftOne — object PRJC («Έργα») → DB πίνακας PRJC. Μπαίνουν ΑΝΑ ΓΡΑΜΜΗ (`PRJC`).
// Το `trdr` επιτρέπει να στενέψει η λίστα στα έργα ΤΟΥ εκδότη του παραστατικού.
model SoftoneProject {
  id       Int      @id @default(autoincrement())
  prjc     Int      @unique          // SoftOne PRJC
  code     String                    // CODE
  name     String                    // NAME
  trdr     Int?                      // TRDR («Πελάτης») — για φιλτράρισμα ανά συναλλασσόμενο
  prjType  Int?                      // PRJTYPE
  isActive Boolean  @default(true)
  syncedAt DateTime @default(now())

  @@index([name])
  @@index([code])
  @@index([trdr])
}

// Δραστηριότητες SoftOne — object PRJCSTAGE («Δραστηριότητες») → DB πίνακας PRJCSTAGE.
// Στη γραμμή λέγεται «Κατηγορία δραστηριότητας».
model SoftoneProjectStage {
  id        Int      @id @default(autoincrement())
  prjcStage Int      @unique         // SoftOne PRJCSTAGE
  code      String                   // CODE (σύντμηση)
  name      String                   // NAME (μπορεί να είναι κενό στο SoftOne → πέφτουμε στο CODE)
  isActive  Boolean  @default(true)
  syncedAt  DateTime @default(now())

  @@index([name])
  @@index([code])
}

// Λίστες χαρακτηρισμού myDATA (EditLists MYDATACLTYPE / MYDATACLCATEGORY). Μητρώα ΑΝΑΦΟΡΑΣ:
// δείχνουν τι σημαίνει ο χαρακτηρισμός που κουβαλά κάθε είδος/υπηρεσία/χρεοπίστωση/έξοδο.
// Η εφαρμογή ΔΕΝ ορίζει χαρακτηρισμό ανά γραμμή — τον ορίζει το μητρώο στο SoftOne.
model SoftoneMyDataClassType {
  id         Int      @id @default(autoincrement())
  sotype     Int                       // SOTYPE (πλευρά: εσόδων/εξόδων)
  code       Int                       // MYDATACLTYPE
  myDataCode String?                   // MYDATACODE (π.χ. «category2_1»)
  sohCode    String?                   // SOHCODE (ομαδοποίηση myDATA)
  name       String
  isVat      Boolean  @default(false)  // ISVAT («Αφορά περιοδική»)
  syncedAt   DateTime @default(now())

  @@unique([sotype, code])
  @@index([name])
}

model SoftoneMyDataClassCategory {
  id         Int      @id @default(autoincrement())
  sotype     Int                       // SOTYPE
  code       Int                       // MYDATACLCATEGORY
  myDataCode String?
  sohCode    String?
  name       String
  syncedAt   DateTime @default(now())

  @@unique([sotype, code])
  @@index([name])
}

// Μνήμη αντιστοίχισης γραμμών: (ΑΦΜ εκδότη ή '' για γενικό, κανονικοποιημένο κείμενο) → είδος/υπηρεσία/έξοδο.
// ΠΡΟΣΟΧΗ: το afm είναι NOT NULL με default '' — η Postgres θεωρεί τα NULL διακριτά στο unique index,
// οπότε οι γενικοί κανόνες γράφονται πάντα με afm = '' και ποτέ NULL.
model LineMatchRule {
  id          String   @id @default(cuid())
  afm         String   @default("")
  pattern     String                     // normalizeLineText του ονόματος της γραμμής
  mtrl        Int?                       // SoftoneItem.mtrl
  expn        Int?                       // SoftoneExpense.expn
  lin         Int?                       // SoftoneLineItem.mtrl (χρεοπίστωση)
  // «Αν το κάνει μια φορά να το θυμάται»: η αναλυτική μαθαίνεται με το ΙΔΙΟ κλειδί (ΑΦΜ + pattern).
  costCntr    Int?                       // SoftoneCostCenter.costcntr
  prjc        Int?                       // SoftoneProject.prjc
  prjcStage   Int?                       // SoftoneProjectStage.prjcStage
  isService   Boolean  @default(false)
  // ΠΟΙΟΣ διάλεξε τον ΣΤΟΧΟ (mtrl/expn/lin): 'manual' = άνθρωπος τον επέλεξε ρητά· 'auto:<πηγή>' =
  // ο στόχος ήρθε από αυτόματη αντιστοίχιση της γραμμής (π.χ. 'auto:code') και γράφτηκε μόνο επειδή
  // ο χρήστης άλλαξε την αναλυτική· NULL = γραμμή πριν από τη στήλη, ΑΓΝΩΣΤΟ. Μόνο το 'manual'
  // μετρά ως ανθρώπινη επιβεβαίωση (βλ. `rememberLineMatch`, `lib/ocr/chart-grounding.ts`).
  targetSource String?
  timesUsed   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([afm, pattern])
  @@index([pattern])
}

// Εκδότες που ο χρήστης επέλεξε να μη δημιουργήσει στο SoftOne.
model IgnoredIssuer {
  afm         String   @id
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
}

// Μνήμη geocoding: μια διεύθυνση ρωτιέται ΜΙΑ φορά τον πάροχο (MapTiler/Nominatim).
//
// Γιατί πίνακας και όχι στήλη JSON: οι ομάδες της ουράς «Νέοι συναλλασσόμενοι» δεν
// έχουν δική τους γραμμή — φτιάχνονται στη μνήμη από τα `OcrDocument` ανά ΑΦΜ. Το
// μόνο «backing data» θα ήταν τα ίδια τα έγγραφα (N γραμμές ανά εκδότη ⇒ N αντίγραφα
// της ίδιας απάντησης). Ένας πίνακας με κλειδί την ΚΑΝΟΝΙΚΟΠΟΙΗΜΕΝΗ διεύθυνση
// μοιράζεται την απάντηση και ανάμεσα σε διαφορετικούς εκδότες της ίδιας διεύθυνσης,
// επιβιώνει restart και — το σημαντικότερο για το quota — κρατά ΚΑΙ τις αστοχίες
// (`found = false`), που αλλιώς θα ξαναρωτιόντουσαν σε κάθε άνοιγμα του panel.
model GeocodeCache {
  id          String   @id @default(cuid())
  // Κανονικοποιημένη διεύθυνση + προαιρετικό country hint — δες `geocodeCacheKey`.
  key         String   @unique
  address     String
  countryHint String?
  // `false` = ο πάροχος δεν αναγνώρισε τη διεύθυνση. Cache-άρεται κι αυτό.
  found       Boolean  @default(false)
  countryCode String?
  country     String?
  city        String?
  zip         String?
  formatted   String?
  lat         Float?
  lng         Float?
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  usedAt      DateTime @default(now())
  // Πότε ρωτήθηκε ΤΕΛΕΥΤΑΙΑ ο πάροχος. Από εδώ μετριέται το παράθυρο επανελέγχου
  // των αστοχιών (`MISS_RETRY_DAYS`) — το `usedAt` χτυπιέται σε κάθε ανάγνωση.
  checkedAt   DateTime @default(now())

  @@index([usedAt])
}
